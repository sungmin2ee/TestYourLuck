# Auto detect text files and perform LF normalization
* text=auto

# Unity serialized text assets
*.cs text diff=csharp
*.shader text
*.compute text
*.cginc text
*.hlsl text
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf

# Large binary assets and native plugins
*.psd filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
